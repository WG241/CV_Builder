# ---------------------------------------------------------------------------
# Workforce — AI Assisted CV Drafting
# Copy this file to `.env.local` for local development, or set these values as
# Environment Variables in your Vercel project. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Required. Server-side only. Used exclusively inside /app/api/* route handlers.
OPENAI_API_KEY=sk-your-key-here

# Optional. Overrides the default hybrid model configuration.
# Leave unset to use the built-in defaults:
#   - drafting / quality review: gpt-4o
#   - analysis / audit / edit:   gpt-4o-mini
# OPENAI_MODEL_HEAVY=gpt-4o
# OPENAI_MODEL_LIGHT=gpt-4o-mini

# Optional. Per-IP generation limits (see lib/ratelimit.ts).
# RATE_LIMIT_GENERATIONS_PER_HOUR=8
# RATE_LIMIT_REQUESTS_PER_MINUTE=20
